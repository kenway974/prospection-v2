# URL de la base PostgreSQL (Railway la fournit : ${{Postgres.DATABASE_URL}}, préfixe postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@hote:5432/base
# Secret de signature des sessions : 32 caractères ou plus, aléatoires (python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=
# Hash du mot de passe d'accès : python -m prospection.cli hash-password
APP_PASSWORD_HASH=
# Clé de chiffrement des clés API (jamais en base) : python -m prospection.cli generate-encryption-key
ENCRYPTION_KEY=
# true derrière le proxy HTTPS de Railway ; false en local
BEHIND_PROXY=false
# Fuseau horaire des dates affichées
TIMEZONE=Europe/Paris
# Facultatif : erreurs remontées à Sentry (offre gratuite), sans données personnelles
SENTRY_DSN=
# Facultatif : sauvegarde quotidienne chiffrée (clé ENCRYPTION_KEY) vers un stockage compatible S3
# (Cloudflare R2 : https://<compte>.r2.cloudflarestorage.com/<seau>) ; un fichier par jour du mois
BACKUP_S3_URL=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
# Facultatif : notifications sur le téléphone (python -m prospection.cli generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:votre@adresse.fr
# Facultatif : mail d'audit depuis Gmail (identifiants OAuth de Google Cloud, voir README)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Facultatif : adresse publique de l'app (https://…) ; par défaut, le domaine Railway
PUBLIC_URL=
